{
  "name": "showroom-app",
  "version": "0.1.0",
  "description": "Cross-platform car showroom marketplace",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/web",
    "apps/mobile",
    "packages/types",
    "packages/api-client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/backend\" \"npm run dev -w apps/web\"",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run dev -w apps/mobile",
    "build": "npm run build -w apps/backend && npm run build -w apps/web && npm run build -w apps/mobile",
    "build:backend": "npm run build -w apps/backend",
    "build:web": "npm run build -w apps/web",
    "build:mobile": "npm run build -w apps/mobile",
    "test": "npm run test:backend && npm run test:web",
    "test:backend": "npm run test -w apps/backend",
    "test:web": "npm run test -w apps/web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react-router-dom": "^7.18.2"
  }
}
